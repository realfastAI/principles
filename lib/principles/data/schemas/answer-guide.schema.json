{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answer-guide.schema.json",
  "title": "Answer guide",
  "description": "Example shapes the assessment request shows for the parts of an answer its template cannot show by example.",
  "type": "object",
  "required": ["finding", "member_delivery", "recent_decision", "reassessment", "check_result"],
  "additionalProperties": false,
  "properties": {
  "finding": {
    "type": "object",
    "required": [
      "copy_to",
      "copy_from",
      "examples",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "copy_to": {
        "type": "string"
      },
      "copy_from": {
        "type": "string"
      },
      "examples": {
        "type": "object",
        "required": [
          "finding"
        ],
        "additionalProperties": false,
        "properties": {
          "finding": {
            "type": "object",
            "required": [
              "id",
              "member_ids",
              "problem",
              "consequence",
              "proposed_action",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "member_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "problem": {
                "type": "string"
              },
              "consequence": {
                "type": "string"
              },
              "proposed_action": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "heading": {
                      "type": "string"
                    },
                    "starting_at": {
                      "type": "string"
                    },
                    "ending_at": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "notes": {
        "type": "string"
      }
    }
  },
  "member_delivery": {
    "type": "object",
    "required": [
      "copy_to",
      "copy_from",
      "examples",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "copy_to": {
        "type": "string"
      },
      "copy_from": {
        "type": "string"
      },
      "examples": {
        "type": "object",
        "required": [
          "not_observed",
          "observed"
        ],
        "additionalProperties": false,
        "properties": {
          "not_observed": {
            "type": "object",
            "required": [
              "delivery"
            ],
            "properties": {
              "delivery": {
                "const": "not_observed"
              }
            },
            "additionalProperties": false
          },
          "observed": {
            "type": "object",
            "required": [
              "delivery",
              "observation"
            ],
            "properties": {
              "delivery": {
                "const": "observed"
              },
              "observation": {
                "type": "string"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "notes": {
        "type": "string"
      }
    }
  },
"recent_decision": {
    "type": "object",
    "required": [
      "copy_to",
      "copy_from",
      "examples"
    ],
    "additionalProperties": false,
    "properties": {
      "copy_to": {
        "type": "string"
      },
      "copy_from": {
        "type": "string"
      },
      "examples": {
        "type": "object",
        "required": [
          "assessed",
          "unavailable"
        ],
        "additionalProperties": false,
        "properties": {
          "assessed": {
            "type": "object",
            "required": [
              "assessment",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "assessment": {
                "type": "string"
              },
              "evidence": {
                "$ref": "#/properties/finding/properties/examples/properties/finding/properties/evidence"
              }
            }
          },
          "unavailable": {
            "type": "object",
            "required": [
              "unavailable_reason"
            ],
            "properties": {
              "unavailable_reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
"reassessment": { "type": "string" },
"check_result": {
  "type": "object",
  "required": [
    "copy_to",
    "copy_from",
    "examples",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "copy_to": {
      "type": "string"
    },
    "copy_from": {
      "type": "string"
    },
    "examples": {
      "type": "object",
      "required": [
        "ran",
        "not_run"
      ],
      "additionalProperties": false,
      "properties": {
        "ran": {
          "type": "object",
          "required": [
            "command",
            "exit_status"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "exit_status": {
              "type": "integer"
            }
          }
        },
        "not_run": {
          "type": "object",
          "required": [
            "command",
            "not_run_reason"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "not_run_reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "limits": {
      "type": "string"
    }
  }
}
  }
}
